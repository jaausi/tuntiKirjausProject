<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests log only to the console so they don't write to the user's real log file -->
<configuration debug="false">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%throwable%n</pattern>
        </encoder>
    </appender>

    <logger name="com.sirvja" level="info"/>

    <root level="warn">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
