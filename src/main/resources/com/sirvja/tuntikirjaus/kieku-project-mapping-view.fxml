<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="400.0" prefWidth="380.0" spacing="10.0" styleClass="main-view" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sirvja.tuntikirjaus.controller.KiekuProjectMappingViewController">
   <padding>
      <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
   </padding>
   <children>
      <Label text="Projektien kohdistus Kiekuun" style="-fx-font-weight: bold; -fx-font-size: 14;" />
      <Label text="Syötä Kieku-projektin nimi (tai sen alkuosa), jolle projektin tunnit kohdistetaan. Tyhjä = Kieku-projekti haetaan projektin omalla nimellä." wrapText="true" style="-fx-font-size: 11; -fx-text-fill: grey;" />
      <TableView fx:id="mappingTable" editable="true" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="projectColumn" text="Projekti" prefWidth="200.0" />
            <TableColumn fx:id="kiekuProjectColumn" text="Kieku-projekti" prefWidth="200.0" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
