<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="500.0" prefWidth="680.0" styleClass="main-view" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sirvja.tuntikirjaus.controller.SettingsViewController">
   <children>
      <TabPane fx:id="settingsTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
         <tabs>
            <Tab fx:id="generalTab" text="Yleiset">
               <content>
                  <VBox spacing="10.0">
                     <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                     </padding>
                     <children>
                        <Label text="Ulkoasu" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                        <CheckBox fx:id="darkThemeCheckBox" mnemonicParsing="false" text="Tumma teema" />
                     </children>
                  </VBox>
               </content>
            </Tab>
            <Tab fx:id="projectBudgetsTab" text="Projektibudjetit">
               <content>
                  <fx:include source="project-budget-view.fxml" />
               </content>
            </Tab>
            <Tab fx:id="kiekuTab" text="Kieku">
               <content>
                  <fx:include source="configuration-view.fxml" />
               </content>
            </Tab>
         </tabs>
      </TabPane>
      <HBox alignment="CENTER_RIGHT" spacing="8.0">
         <padding>
            <Insets bottom="8.0" left="12.0" right="12.0" top="8.0" />
         </padding>
         <children>
            <Button text="Sulje" onAction="#onCloseButtonClick" />
         </children>
      </HBox>
   </children>
</VBox>
