<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="400.0" prefWidth="640.0" spacing="5.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sirvja.tuntikirjaus.controller.KiekuHoursExportViewController">
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <DatePicker fx:id="startDateField" promptText="Alku pvm" />
            <DatePicker fx:id="endDateField" promptText="Loppu pvm" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button fx:id="searchButton" mnemonicParsing="false" prefWidth="149.0" text="Hae tunnit" />
         </children>
      </HBox>
      <Label text="Tunnit summataan projekteittain ja päivittäin. Kieku-projektin voi vaihtaa asetusten Kieku-projektit-välilehdellä. Jos rivejä ei ole valittu, viedään kaikki rivit." wrapText="true" style="-fx-font-size: 11; -fx-text-fill: grey;" />
      <TableView fx:id="hoursTable" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="dateColumn" prefWidth="110.0" text="Päivä" />
            <TableColumn fx:id="projectColumn" prefWidth="200.0" text="Projekti" />
            <TableColumn fx:id="kiekuProjectColumn" prefWidth="200.0" text="Kieku-projekti" />
            <TableColumn fx:id="hoursColumn" prefWidth="80.0" text="Tunnit" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Button fx:id="exportButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="44.0" text="Kohdista tunnit Kiekuun" />
   </children>
</VBox>
